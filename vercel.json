{
  "version": 2,
  "builds": [
    {
      "src": "website/landing-page/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/website/landing-page/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/website/landing-page/$1"
    }
  ],
  "outputDirectory": "website/landing-page"
}
