{
  "version": 2,
  "builds": [
    {
      "src": "website/landing-page/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/website/landing-page/index.html"
    },
    {
      "src": "/(logo\.svg|index\.html)",
      "dest": "/website/landing-page/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/website/landing-page/$1"
    }
  ]
}
