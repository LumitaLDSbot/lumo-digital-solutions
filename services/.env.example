# RunPod API Configuration
# Copia este archivo a .env y completa con tus credenciales reales

# RunPod API Key (obtenida de https://runpod.io/console/user/settings)
RUNPOD_API_KEY=tu_api_key_aqui

# RunPod Endpoint ID (ya configurado: f848cy1mvburyj)
RUNPOD_ENDPOINT=f848cy1mvburyj

# Opcional: Timeout en milisegundos para generaciones largas
RUNPOD_TIMEOUT=300000

# Opcional: GPU preferida (RTX 4090 recomendado)
RUNPOD_GPU=RTX_4090
